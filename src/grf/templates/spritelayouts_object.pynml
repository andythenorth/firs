<!--! grf_object not object in case it conflicts with python 'object' at any point (might not, but who wants to test that?) -->
<tal:objects repeat="grf_object industry.objects.values()">
    <tal:view repeat="view grf_object.views">
        <tal:spritelayouts repeat="x_y_spritelayout view">
            <tal:spritelayout define="spritelayout x_y_spritelayout[2]">
                <!--!
                    Objects use the same single conditional spritelayout model as industries.
                    Land/water/coast differences are handled inside the spritelayout rather than
                    by generating separate _land and _water layouts.
                -->
                spritelayout ${grf_object.id}_view_${repeat.view.index}_spritelayout_${repeat.x_y_spritelayout.index} {
                <tal:ground_sprite switch="spritelayout.terrain_aware_ground">
                    <tal:terrain_aware_ground case="True">
                        <!--! ground sprite from terrain -->
                        ground {
                            sprite: (LOAD_TEMP(${graphics_temp_storage.var_terrain_sprite}));
                        }
                    </tal:terrain_aware_ground>
                    <tal:terrain_aware_ground case="False">
                        <!--! explicit ground sprite from industry, if not empty -->
                        <tal:conditional_ground condition="spritelayout.ground_sprite != None">
                            childsprite {
                                sprite: ${industry.unpack_sprite_or_spriteset(spritelayout.ground_sprite)};
                                hide_sprite: (LOAD_TEMP(${graphics_temp_storage.var_terrain_is_snow}));
                                always_draw: 1;
                            }
                            <!--! ...explicit ground sprite from industry with snow -->
                            childsprite {
                                sprite: ${industry.unpack_sprite_or_spriteset(spritelayout.ground_sprite, snow_overlay=True)};
                                hide_sprite: (!LOAD_TEMP(${graphics_temp_storage.var_terrain_is_snow}));
                                always_draw: 1;
                            }
                        </tal:conditional_ground>
                    </tal:terrain_aware_ground>
                </tal:ground_sprite>

                <!--! industry ground overlay, if not empty -->
                <tal:not_empty condition="spritelayout.ground_overlay != None">
                    childsprite {
                        sprite: ${industry.unpack_sprite_or_spriteset(spritelayout.ground_overlay)};
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        hide_sprite: (LOAD_TEMP(${graphics_temp_storage.var_terrain_is_snow}));
                        always_draw: 1;
                    }
                    <!--! ...industry ground overlay with snow -->
                    childsprite {
                        sprite: ${industry.unpack_sprite_or_spriteset(spritelayout.ground_overlay, snow_overlay=True)};
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        hide_sprite: (!LOAD_TEMP(${graphics_temp_storage.var_terrain_is_snow}));
                        always_draw: 1;
                    }
                </tal:not_empty>

                <!--! reuse of jetty surface required when a normally-water-based layout is built on land -->
                <tal:jetty_surface_on_land condition="spritelayout.jetty_surface_on_land != None">
                    childsprite {
                        sprite: ${industry.unpack_sprite_or_spriteset(spritelayout.jetty_surface_on_land)};
                        hide_sprite: LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea}) || LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast});
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        always_draw: 1;
                    }
                </tal:jetty_surface_on_land>

                <tal:optional_fence condition="'ne' in spritelayout.fences">
                    <!--! fences NE -->
                    building {
                        sprite: 1302 + LOAD_TEMP(${graphics_temp_storage.var_fencesprite_ne});
                        <tal:hide_sprite condition="'ne' not in spritelayout.perma_fences">
                            hide_sprite: (LOAD_TEMP(${graphics_temp_storage.var_use_fence_ne}) == 0);
                        </tal:hide_sprite>
                        xoffset: 0;
                        yoffset: 0;
                        zoffset: (LOAD_TEMP(${graphics_temp_storage.var_fence_offset_ne}) * 8) + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: 1;
                        yextent: 16;
                        zextent: 6;
                        recolour_mode: RECOLOUR_REMAP;
                        palette:       PALETTE_USE_DEFAULT;
                    }
                </tal:optional_fence>
                <tal:optional_fence condition="'nw' in spritelayout.fences">
                    <!--! fences NW -->
                    building {
                        sprite: 1301 + LOAD_TEMP(${graphics_temp_storage.var_fencesprite_nw});
                        <tal:hide_sprite condition="'nw' not in spritelayout.perma_fences">
                            hide_sprite: (LOAD_TEMP(${graphics_temp_storage.var_use_fence_nw}) == 0);
                        </tal:hide_sprite>
                        xoffset: 0;
                        yoffset: 0;
                        zoffset: (LOAD_TEMP(${graphics_temp_storage.var_fence_offset_nw}) * 8) + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: 16;
                        yextent: 1;
                        zextent: 6;
                        recolour_mode: RECOLOUR_REMAP;
                        palette:       PALETTE_USE_DEFAULT;
                    }
                </tal:optional_fence>

                <tal:jetty_foundations condition="spritelayout.jetty_foundations">
                    <!--!
                        Optional manual handling of jetties for water objects.
                        These sprites are pre-composed whole-tile graphics containing both
                        the jetty foundation and its surface; no separate surface overlay
                        is required here.
                    -->
                    building {
                        sprite: spriteset_jetty_foundations_and_surface_1(slope_to_sprite_offset(nearby_tile_slope(0,0)));
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        xoffset: 0;
                        yoffset: 0;
                        zoffset: (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: 16;
                        yextent: 16;
                        zextent: 8;
                        always_draw: 1;
                        hide_sprite: !(LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea}) || LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                    }

                    <!--! CABBAGE reuse of jetty surface required when a normally-water-based layout is built on land -->
                    <tal:jetty_deck_overlay condition="spritelayout.jetty_deck_overlay != None">
                        building {
                            sprite: ${industry.unpack_sprite_or_spriteset(spritelayout.jetty_deck_overlay)};
                            recolour_mode: RECOLOUR_REMAP;
                            palette: PALETTE_USE_DEFAULT;
                            xoffset: 0;
                            yoffset: 0;
                            zoffset: (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                            xextent: 16;
                            yextent: 16;
                            zextent: 8;
                            always_draw: 1;
                            hide_sprite: !(LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea}) || LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        }
                    </tal:jetty_deck_overlay>

                </tal:jetty_foundations>

                <tal:building_sprites repeat="building_sprite spritelayout.building_sprites">
                    <!--! buildings (snow aware) -->
                    building {
                        sprite: ${industry.unpack_sprite_or_spriteset(building_sprite, construction_state_num=3)};
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        xoffset: ${building_sprite.xoffset};
                        yoffset: ${building_sprite.yoffset};
                        zoffset: ${building_sprite.zoffset} + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: ${building_sprite.xextent};
                        yextent: ${building_sprite.yextent};
                        zextent: ${building_sprite.zextent};
                        always_draw: ${building_sprite.always_draw};
                        hide_sprite: LOAD_TEMP(${graphics_temp_storage.var_terrain_is_snow});
                    }
                    building {
                        sprite: ${industry.unpack_sprite_or_spriteset(building_sprite, construction_state_num=3, snow_overlay=True)};
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        xoffset: ${building_sprite.xoffset};
                        yoffset: ${building_sprite.yoffset};
                        zoffset: ${building_sprite.zoffset} + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: ${building_sprite.xextent};
                        yextent: ${building_sprite.yextent};
                        zextent: ${building_sprite.zextent};
                        always_draw: ${building_sprite.always_draw};
                        hide_sprite: !LOAD_TEMP(${graphics_temp_storage.var_terrain_is_snow});
                    }
                </tal:building_sprites>

                <tal:magic_trees condition="len(spritelayout.magic_trees) > 0" repeat="magic_tree spritelayout.magic_trees">
                    <!--! magic trees, magically added by industry.add_magic_spritelayout() -->
                    building {
                        sprite: ${magic_tree.default};
                        hide_sprite: LOAD_TEMP(${graphics_temp_storage.var_magic_trees_hide_default});
                        xoffset: ${magic_tree.xoffset};
                        yoffset: ${magic_tree.yoffset};
                        <!--! x and y extents need to be 4 or so for trees to prevent flickering -->
                        xextent: 4;
                        yextent: 4;
                        zextent: 32;
                    }
                    building {
                        sprite: ${magic_tree.snow};
                        hide_sprite: LOAD_TEMP(${graphics_temp_storage.var_magic_trees_hide_snow});
                        xoffset: ${magic_tree.xoffset};
                        yoffset: ${magic_tree.yoffset};
                        <!--! x and y extents need to be 4 or so for trees to prevent flickering -->
                        xextent: 4;
                        yextent: 4;
                        zextent: 32;
                    }
                    building {
                        sprite: ${magic_tree.tropic};
                        hide_sprite: LOAD_TEMP(${graphics_temp_storage.var_magic_trees_hide_tropic});
                        xoffset: ${magic_tree.xoffset};
                        yoffset: ${magic_tree.yoffset};
                        <!--! x and y extents need to be 4 or so for trees to prevent flickering -->
                        xextent: 4;
                        yextent: 4;
                        zextent: 32;
                    }
                </tal:magic_trees>

                <tal:optional_smoke repeat="smoke_sprite spritelayout.smoke_sprites">
                    <!--! smoke sprites -->
                    building {
                        sprite: ${smoke_sprite.sprite_number};
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                        xoffset: ${smoke_sprite.xoffset};
                        yoffset: ${smoke_sprite.yoffset};
                        zoffset: ${smoke_sprite.zoffset} + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: ${smoke_sprite.xextent};
                        yextent: ${smoke_sprite.yextent};
                        zextent: ${smoke_sprite.zextent};
                        hide_sprite: ${smoke_sprite.hide_sprite};
                    }
                </tal:optional_smoke>

                <tal:optional_fence condition="'se' in spritelayout.fences">
                    <!--! fences SE -->
                    building {
                        sprite: 1301 + LOAD_TEMP(${graphics_temp_storage.var_fencesprite_se});
                        <tal:hide_sprite condition="'se' not in spritelayout.perma_fences">
                            hide_sprite: (LOAD_TEMP(${graphics_temp_storage.var_use_fence_se}) == 0);
                        </tal:hide_sprite>
                        xoffset: 0;
                        yoffset: 16;
                        zoffset: (LOAD_TEMP(${graphics_temp_storage.var_fence_offset_se}) * 8) + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: 16;
                        yextent: 1;
                        zextent: 6;
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                    }
                </tal:optional_fence>
                <tal:optional_fence condition="'sw' in spritelayout.fences">
                    <!--! fences SW -->
                    building {
                        sprite: 1302 + LOAD_TEMP(${graphics_temp_storage.var_fencesprite_sw});
                        <tal:hide_sprite condition="'sw' not in spritelayout.perma_fences">
                            hide_sprite: (LOAD_TEMP(${graphics_temp_storage.var_use_fence_sw}) == 0);
                        </tal:hide_sprite>
                        xoffset: 16;
                        yoffset: 0;
                        zoffset: (LOAD_TEMP(${graphics_temp_storage.var_fence_offset_sw}) * 8) + (${spritelayout.cabbage_water_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_flat_sea})) + (${spritelayout.cabbage_coast_zoffset} * LOAD_TEMP(${graphics_temp_storage.var_tile_is_built_on_coast}));
                        xextent: 1;
                        yextent: 16;
                        zextent: 6;
                        recolour_mode: RECOLOUR_REMAP;
                        palette: PALETTE_USE_DEFAULT;
                    }
                </tal:optional_fence>
                }
            </tal:spritelayout>
        </tal:spritelayouts>
    </tal:view>
</tal:objects>
